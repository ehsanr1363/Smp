<Window x:Class="Smp.ContractTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ویرایش متن قرارداد پرسنلی" Width="1040" Height="720" MinWidth="760" MinHeight="520"
        FlowDirection="RightToLeft" FontFamily="Vazirmatn, Tahoma" FontSize="14"
        Background="#F3F6F5" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="Brand" Color="#0B5A54"/>
        <SolidColorBrush x:Key="Line" Color="#D9E3E0"/>
        <SolidColorBrush x:Key="Soft" Color="#E3F2EF"/>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Brand}"/>
            <Setter Property="Padding" Value="22,8"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#F3F6F5" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Soft}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brand}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="used">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Padding" Value="14,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,14">
            <Border x:Name="StatusPill" DockPanel.Dock="Left" CornerRadius="99" Background="{StaticResource Soft}"
                    Padding="12,3" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="ذخیره‌شده" Foreground="{StaticResource Brand}" FontSize="13"/>
            </Border>
            <StackPanel>
                <TextBlock Text="ویرایش متن قرارداد پرسنلی" FontSize="22" FontWeight="Bold" Foreground="#16302B"/>
                <TextBlock Text="متن قالب را یک بار بنویسید؛ برای هر کارمند خودکار پر می‌شود."
                           Foreground="#5D726D" FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Codes panel -->
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="کدهای خودکار" FontWeight="Bold"/>
                        <TextBlock Text="روی هر کد بزنید تا در جای مکان‌نما درج شود."
                                   Foreground="#5D726D" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel x:Name="GroupsHost"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="12,10">
                        <Border Background="#F3F6F5" CornerRadius="10" Padding="3" DockPanel.Dock="Right">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabEdit" Style="{StaticResource Tab}" Content="ویرایش"
                                             IsChecked="True" Checked="Tab_Changed"/>
                                <RadioButton x:Name="TabPreview" Style="{StaticResource Tab}" Content="پیش‌نمایش با نمونه"
                                             Checked="Tab_Changed"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="بازگشت به آخرین ذخیره" Click="Revert_Click" Padding="12,3"
                                    Margin="0,0,0,0" Background="White" Foreground="#16302B" Style="{StaticResource Pill}"/>
                            <Button Content="واگرد" Click="Undo_Click" Padding="12,3"
                                    Background="White" Foreground="#16302B" Style="{StaticResource Pill}"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,0">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1">
                            <Grid>
                                <TextBox x:Name="EditorBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="22,16"
                                         FontSize="15" TextChanged="EditorBox_TextChanged" SpellCheck.IsEnabled="False"/>
                                <RichTextBox x:Name="PreviewBox" IsReadOnly="True" Visibility="Collapsed"
                                             BorderThickness="0" Padding="22,16" FontSize="15"
                                             VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="14,8">
                        <TextBlock x:Name="CountText" Foreground="#5D726D" FontSize="12" DockPanel.Dock="Right" Margin="0,0,16,0"/>
                        <TextBlock x:Name="UsedText" Foreground="#5D726D" FontSize="12" DockPanel.Dock="Right" Margin="0,0,16,0"/>
                        <Border x:Name="BadPill" Visibility="Collapsed" Background="#FEF3C7" CornerRadius="99" Padding="10,1"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="BadText" Foreground="#B45309" FontSize="12"/>
                        </Border>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="ذخیره متن قرارداد" Click="Save_Click" Style="{StaticResource Pill}"/>
            <Button Content="ایمپورت از اکسل" Click="Import_Click" Style="{StaticResource Pill}"
                    Background="#E3F2EF" Foreground="#0B5A54"/>
        </StackPanel>
    </Grid>
</Window>
